# PostgreSQL
POSTGRES_DB=bicsa_db
POSTGRES_USER=bicsa_user
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO

# Backend
NODE_ENV=development
PORT=3001
JWT_SECRET=CAMBIAR_POR_SECRET_LARGO_Y_ALEATORIO_256_BITS
JWT_EXPIRES_IN=8h
DATABASE_URL=postgresql://bicsa_user:CAMBIAR_POR_PASSWORD_SEGURO@postgres:5432/bicsa_db

# Frontend
VITE_API_URL=/api

# Superadmin inicial (solo para seed inicial)
